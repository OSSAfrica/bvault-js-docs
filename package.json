{
  "name": "bvault-js-docs",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "vite dev --host 127.0.0.1",
    "build": "vite build && node scripts/prepare-pages.mjs",
    "typecheck": "tsc --noEmit",
    "check-format": "prettier --check .",
    "format": "prettier --write .",
    "check:content": "node scripts/check-content.mjs",
    "test:smoke": "playwright test",
    "ci": "npm run check-format && npm run build && npm run typecheck && npm run check:content && npm run test:smoke",
    "preview": "wrangler pages dev dist/client --port 4173",
    "deploy": "npm run build && wrangler pages deploy dist/client --project-name bvault-js-docs"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.5",
    "fumadocs-core": "16.19.0",
    "fumadocs-mdx": "15.6.1",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.19.0",
    "lucide-react": "^1.71.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "prettier": "^3.6.2",
    "@playwright/test": "^1.56.1",
    "wrangler": "^4.45.0",
    "cheerio": "^1.1.2"
  },
  "version": "0.0.0",
  "engines": {
    "node": ">=22.13.0"
  }
}
